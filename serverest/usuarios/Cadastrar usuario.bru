meta {
  name: Cadastrar usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "nome": "{{nome}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "administrador": "{{administrador}}"
  }
}

script:pre-request {
  if (!bru.getVar("email") || !bru.getVar("password")) {
    const ts = Date.now();
    const suffix = Math.floor(Math.random() * 10000);
    bru.setVar("nome", `Usuario QA ${ts}`);
    bru.setVar("email", `usuario.${ts}.${suffix}@qa.com.br`);
    bru.setVar("password", `Senha@${suffix}`);
    bru.setVar("administrador", "true");
  }

  if (!bru.getVar("nome")) {
    bru.setVar("nome", "Usuario QA");
  }

  if (!bru.getVar("administrador")) {
    bru.setVar("administrador", "true");
  }
}

assert {
  res.status: eq 201
  res.body.message: eq Cadastro realizado com sucesso
  res.body._id: isString
}

script:post-response {
  bru.setVar("userId", res.body._id);
}

docs {
  Cadastra um usuário administrador.
  
  Se `email`/`password` não existirem, gera dados fake dinâmicos.
  
  Responsável por salvar `userId` (e deixar `email`/`password` disponíveis para o login).
}
